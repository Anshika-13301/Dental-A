PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/dentagent

# Security
JWT_SECRET=dentagent_jwt_super_secret_key_2026_healthcare
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=dentagent_refresh_super_secret_key_2026_healthcare

# Nodemailer Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=DentAgent AI <no-reply@dentagent.ai>

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
